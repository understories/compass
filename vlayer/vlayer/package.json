{
  "name": "simple-email-proof",
  "module": "prove.ts",
  "type": "module",
  "scripts": {
    "devnet:up": "docker compose --file docker-compose.devnet.yaml up -d",
    "devnet:down": "docker compose --file docker-compose.devnet.yaml down",
    "lint:solidity": "solhint '../src/**/*.sol' --max-warnings 0 && forge fmt ../src --check",
    "lint-fix:solidity": "solhint '../src/**/*.sol' --fix --noPrompt && forge fmt ../src",
    "deploy:dev": "VLAYER_ENV=dev bun run deploy.ts",
    "deploy:testnet": "VLAYER_ENV=testnet bun run deploy.ts",
    "deploy:mainnet": "VLAYER_ENV=mainnet bun run deploy.ts",
    "prove:dev": "VLAYER_ENV=dev bun run prove.ts",
    "prove:testnet": "VLAYER_ENV=testnet bun run prove.ts",
    "prove:mainnet": "VLAYER_ENV=mainnet bun run prove.ts",
    "web:dev": "bun run deploy:dev && vite",
    "web:testnet": "bun run deploy:testnet && vite",
    "web:mainnet": "bun run deploy:mainnet && vite",
    "test-web:dev": "VLAYER_ENV=dev bun run playwright test",
    "test-web:testnet": "VLAYER_ENV=testnet bun run playwright test"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@sentry/react": "^8.55.2",
    "@tanstack/react-query": "^5.104.5",
    "@vercel/analytics": "^1.6.1",
    "@vlayer/react": "1.0.2",
    "@vlayer/sdk": "1.0.2",
    "debug": "^4.4.3",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-daisyui": "^5.0.5",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^5.0.0",
    "react-router": "^7.18.4",
    "usehooks-ts": "^3.1.1",
    "uuid": "^11.1.1",
    "viem": "2.27.0",
    "wagmi": "2.14.16",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@johanneskares/wallet-mock": "^1.4.1",
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.3",
    "@types/eslint__js": "^8.42.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "globals": "^15.15.0",
    "playwright": "1.64.1",
    "postcss": "^8.5.31",
    "solhint": "5.0.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "overrides": {
    "viem": {
      ".": "2.27.0",
      "ws": "^8.21.0"
    },
    "wagmi": "2.14.16"
  }
}
